;;;626    /**
;;;627      * @brief mask the specified I2C interrupt.
;;;628      * @param  I2Cx: where x can be 0 or 1
;;;629      * @param  I2C_INT
;;;630      * This parameter can be one of the following values:
;;;631      *     @arg I2C_INT_GEN_CALL: Set only when a General Call address is received and it is acknowledged.
;;;632      *     @arg I2C_INT_START_DET: Indicates whether a START or RESTART condition has occurred on the I2C
;;;633                                  interface regardless of whether I2C is operating in slave or master mode.
;;;634      *     @arg I2C_INT_STOP_DET:  Indicates whether a STOP condition has occurred on the I2C interface regardless
;;;635                                  of whether I2C is operating in slave or master mode
;;;636      *     @arg I2C_INT_ACTIVITY:  This bit captures I2C activity and stays set until it is cleared.
;;;637      *     @arg I2C_INT_RX_DONE:   When the I2C is acting as a slave-transmitter, this bit is set to 1 if the
;;;638                                  master does not acknowledge a transmitted byte. This occurs on the last byte of
;;;639                                  the transmission, indicating that the transmission is done.
;;;640      *     @arg I2C_INT_TX_ABRT:   This bit indicates if I2C as an I2C transmitter, is unable to complete the
;;;641                                  intended actions on the contents of the transmit FIFO.
;;;642      *     @arg I2C_INT_RD_REQ:    This bit is set to 1 when acting as a slave and another I2C master
;;;643                                  is attempting to read data.
;;;644      *     @arg I2C_INT_TX_EMPTY:  This bit is set to 1 when the transmit buffer is at or below the threshold value set
;;;645                                  in the IC_TX_TL register.
;;;646      *     @arg I2C_INT_TX_OVER:   Set during transmit if the transmit buffer is filled to IC_TX_BUFFER_DEPTH and
;;;647                                  the processor attempts to issue another I2C command.
;;;648      *     @arg I2C_INT_RX_FULL:   Set when the receive buffer reaches or goes above the RX_TL threshold in the
;;;649                                  IC_RX_TL register
;;;650      *     @arg I2C_INT_RX_OVER:   Set if the receive buffer is completely filled to IC_RX_BUFFER_DEPTH and an
;;;651                                   additional byte is received from an external I2C device.
;;;652      *     @arg I2C_INT_RX_UNDER:   Set if the processor attempts to read the receive buffer when it is empty by reading.
;;;653      * @retval None.
;;;654      */
;;;655    void I2C_INTConfig(I2C_TypeDef *I2Cx, uint16_t I2C_INT, FunctionalState NewState)
;;;656    {
;;;657        /* Check the parameters */
;;;658        assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;659        assert_param(I2C_GET_INT(I2C_INT));
;;;660        assert_param(IS_FUNCTIONAL_STATE(NewState));
;;;661    
;;;662        if (NewState != DISABLE)
;;;663        {
;;;664            /* Enable the selected I2C interrupts */
;;;665            I2Cx->IC_INTR_MASK |= I2C_INT;
;;;666        }
;;;667        else
;;;668        {
;;;669            /* Disable the selected I2C interrupts */
;;;670            I2Cx->IC_INTR_MASK &= (uint16_t)~I2C_INT;
;;;671        }
;;;672    }
