;;;97                            | (I2C_InitStruct->I2C_AddressMode << 12);
;;;98             /*set SDA hold time in master mode*/
;;;99             I2Cx->IC_SDA_HOLD = 0x01;
;;;100    
;;;101            I2C_RisingTimeNs = I2C_InitStruct->I2C_RisingTimeNs;
;;;102            /*------------------------------ configure I2C speed ------------------------------*/
;;;103            I2C_SetClockSpeed(I2Cx, I2C_InitStruct->I2C_ClockSpeed);
;;;104        }
;;;105        else
;;;106        {
;;;107            /* set to slave mode */
